{
  "name": "whistle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Developer-first music track resolver (Cloudflare Worker)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "db:migrate:local": "wrangler d1 migrations apply whistle --local",
    "dump:seed-cases": "node --env-file-if-exists=.dev.vars --experimental-sqlite --import tsx scripts/dump-seed-cases.ts",
    "replay:seed-archive": "node --env-file-if-exists=.dev.vars --experimental-sqlite --import tsx scripts/replay-seed-archive.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "nanoid": "^5.1.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.20261020.1",
    "@types/node": "^24.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.156.2"
  }
}
