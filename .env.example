PORT=3000
DATABASE_PATH=./data/whistle.db

# Required by MusicBrainz (descriptive UA; a default is used if unset)
MUSICBRAINZ_USER_AGENT=Whistle/1.0 ( https://github.com/friedtori/whistle )

# Apple Music catalog API (optional). Without these, Whistle falls back to
# the public iTunes Search/Lookup API for Apple song IDs and search.
APPLE_MUSIC_TOKEN=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_STOREFRONT=us

# Tidal Open API v2 (optional; platform is skipped when unset)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY=US

# Spotify Web API (optional; never required — resolved last, never trusted alone)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (optional; YouTube Music is fuzzy-only)
YOUTUBE_API_KEY=

# Set to 1 to run live provider tests (Deezer + MusicBrainz need no keys)
WHISTLE_LIVE_TESTS=
